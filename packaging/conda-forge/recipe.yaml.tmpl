context:
  version: "$version"
  python_min: "3.12"

package:
  name: protocolith
  version: $${{ version }}

source:
  url: https://pypi.org/packages/source/c/protocolith/protocolith-$${{ version }}.tar.gz
  sha256: $sdist_sha256

build:
  number: 0
  noarch: python
  script: $${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation
  python:
    entry_points:
      - protocolith = protocolith.cli:main

requirements:
  host:
    - python $${{ python_min }}.*
    - hatchling
    - hatch-fancy-pypi-readme >=24.1.0
    - pip
  run:
    - python >=$${{ python_min }}
    - numpy >=2.5.2
    - pdfplumber >=0.11
    - pypdf >=6.16.0

tests:
  - python:
      imports:
        - protocolith
      pip_check: true
      python_version:
        - $${{ python_min }}.*
        - "*"
  - requirements:
      run:
        - python $${{ python_min }}.*
    script:
      - protocolith --version
      - protocolith doctor

about:
  homepage: https://github.com/protocolith/protocolith
  summary: Evidence cards for narrow public AI, ML and data claims
  description: |
    Protocolith turns a narrow public claim into an evidence card with a frozen
    protocol, hashed sources, an exact result status, a claim boundary and a
    reproduction level. The package provides the card validator and the
    card-level command-line tools.
  license: Apache-2.0
  license_file:
    - LICENSE
    - NOTICE
  documentation: https://protocolith.github.io/protocolith/docs/
  repository: https://github.com/protocolith/protocolith

extra:
  recipe-maintainers:
    - NeoZorK
